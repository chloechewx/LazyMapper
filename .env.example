# Keep both keys server-side. The normal JSON-first workflow requires no Instagram login.
# Do not commit the real .env file. Gemini is fixed in code to gemini-2.5-flash-lite.
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
PORT=4173

# Local protection caps. Grounded calls consume both Gemini request buckets.
# The app blocks new outbound calls when any applicable cap is reached.
GEMINI_DAILY_REQUEST_CAP=20
GEMINI_DAILY_TOKEN_CAP=100000
GEMINI_GROUNDING_DAILY_REQUEST_CAP=100
GOOGLE_PLACES_MONTHLY_REQUEST_CAP=100

